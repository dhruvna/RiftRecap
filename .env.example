# Required Discord/Riot credentials
DISCORD_BOT_TOKEN=...
DISCORD_CLIENT_ID=...
RIOT_TFT_API_KEY=...
RIOT_LOL_API_KEY=...

# Riot region used when code needs a fallback region. Supported values include NA, EUW, EUNE, KR, BR, LAN, LAS, OCE, JP, RU, TR, VN, SG, PH, TH, and TW.
DEFAULT_REGION=NA

# Polling and rank refresh cadence
MATCH_POLL_INTERVAL_SECONDS=60
RANK_REFRESH_INTERVAL_MINUTES=180

# Daily autopost schedule, in UTC
RECAP_AUTOPOST_HOUR=9
RECAP_AUTOPOST_MINUTE=0

# Announcement behavior
LOL_POST_MATCH_ANNOUNCEMENT_STRATEGY=edit
TFT_POST_MATCH_ANNOUNCEMENT_STRATEGY=edit
LIVE_ANNOUNCE_RANKED_ONLY=true

# Logging
DEBUG=false
LOG_LEVEL=info

# Storage path overrides
DATA_DIR=./user_data
DATA_PATH=./user_data/registrations.json
LOL_LINEUPS_DATA_PATH=./user_data/lol_lineups.json
